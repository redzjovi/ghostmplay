# Copy to .env for local development.
#
# On cPanel you do not need this file: set the variables in Application Manager's
# Environment Variables table instead, which is what Passenger passes to the app.
# A real environment variable always beats a line here.
#
# Only DATABASE_URL is required. Everything else has a safe default.

# --- database -------------------------------------------------------------
# The address depends on where the API runs; nothing is hardcoded.
#
#   local, API on the host (pnpm dev)          127.0.0.1:5432
#   local, API in a container                  host.docker.internal:5432
#   cPanel                                     127.0.0.1:5432
#
# `pnpm db:up` reads this URL and starts a matching PostgreSQL 17 container, so
# changing the port here is enough.
#
# NEVER point this at the production database: migrations run on API boot, so a
# local run would apply local migration files to live data.
DATABASE_URL=postgres://ghostmplay:ghostmplay@127.0.0.1:5432/ghostmplay
# cPanel's PostgreSQL listens on localhost, so TLS is not needed there. Set this
# only for a managed external database (Neon, Supabase, ...) reached over TLS.
# DATABASE_SSL=false

# --- google sign-in -------------------------------------------------------
# The ONLY way in: there is no username, no password and no register endpoint, so
# Google is both the login mechanism and the admin mechanism. Leave these empty and
# the API still boots, but nobody can sign in — main.ts logs a warning saying so.
# Deliberately not fatal when missing, so upgrading never breaks a deployment that
# has not set them up yet.
#
# From the Google Cloud console: an OAuth 2.0 Web application client. Add the exact
# redirect URI below under "Authorized redirect URIs" — a mismatch fails only at
# Google's end, after the visitor has already been redirected away.
#   - Authorized JavaScript origins: the app's origin, e.g. https://example.com
#   - Authorized redirect URIs:     <origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Who may be an admin: verified Google addresses, comma-separated, compared
# case-insensitively. Recomputed on EVERY sign-in, so adding an address grants admin
# at that person's next sign-in and removing one revokes it at theirs. Left empty,
# visitors can sign in but nobody can reach /admin/data, and boot logs a warning.
#
# Safety comes from three things: the ID token is rejected unless email_verified is
# true, only one Google account can hold a given address, and you chose the value
# here. This is the only path to admin — there is no password account left — so if
# the Google account is ever locked out, recovery is a manual
# `UPDATE accounts SET role='admin' WHERE id = <row for a signed-in account>`.
GOOGLE_ADMIN_EMAILS=

# Optional HMAC key for the signed OAuth `state`. If unset it is derived from
# GOOGLE_CLIENT_SECRET, so a third secret does not have to be provisioned. Set it
# explicitly only to rotate the state key without rotating the OAuth client.
# GOOGLE_OAUTH_STATE_SECRET=

# --- server ---------------------------------------------------------------
# PORT is assigned by Passenger on cPanel; 8080 is only the local default.
PORT=8080
# Where the built web app lives. Unset is correct on cPanel: the release
# artifact's own public/ directory is found relative to the app, whatever the
# working directory is.
# WEB_ROOT=/home/user/ghostmplay/release/public
# LiteSpeed forwards the real client IP in X-Forwarded-For; without this the app
# sees the proxy and per-IP rate limiting is useless.
TRUST_PROXY=1
# Leave empty for same-origin only, which is the correct setting when the SPA is
# served by this same process.
# CORS_ORIGINS=https://example.com

# --- schema ---------------------------------------------------------------
# Migrations run automatically on boot. Set to false to require an explicit
# `pnpm migration:run` instead, which is worth doing on shared hosting if you
# would rather see a migration failure in the terminal than as a 502.
# MIGRATIONS_RUN=true
# synchronize is hard-coded false and must stay that way against a shared DB.

# --- debug ----------------------------------------------------------------
# LOG_API=1
# LOG_QUERY=1
