# Copy to .env for local development.
#
# On a deployed service you do not need this file: set the variables in the
# platform's Environment Variables table instead, which is what the process
# receives. A real environment variable always beats a line here, so a stray .env
# inside a container image cannot override what the platform set.
#
# Point ENV_FILE at a specific file to bypass the upward search for the nearest
# .env; that is also how the tests run without picking up this developer's own
# credentials.
#
# Only DATABASE_URL is required. Everything else has a safe default.

# --- database -------------------------------------------------------------
# The address depends on where the API runs; nothing is hardcoded.
#
#   local, API on the host (pnpm dev)          127.0.0.1:5432
#   deployed (managed Postgres)                the connection string given to you
#
# `pnpm db:up` reads this URL and starts a matching PostgreSQL 17 container, so
# changing the port here is enough.
#
# NEVER point this at the production database: migrations run on boot, so a local
# run would apply local migration files to live data.
DATABASE_URL=postgres://ghostmplay:ghostmplay@127.0.0.1:5432/ghostmplay
# A managed database is reached over TLS; set this when DATABASE_URL does not
# already carry an sslmode. A local database does not need it.
# DATABASE_SSL=true

# --- google sign-in -------------------------------------------------------
# The ONLY way in: there is no username, no password and no register endpoint, so
# Google is both the login mechanism and the admin mechanism. Leave these empty and
# the API still boots, but nobody can sign in — it logs a warning saying so.
# Deliberately not fatal when missing, so upgrading never breaks a deployment that
# has not set them up yet.
#
# From the Google Cloud console: an OAuth 2.0 Web application client. Add the exact
# redirect URI below under "Authorized redirect URIs" — a mismatch fails only at
# Google's end, after the visitor has already been redirected away.
#   - Authorized JavaScript origins: the app's origin, e.g. https://example.com
#   - Authorized redirect URIs:     <origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Who may be an admin: verified Google addresses, comma-separated, compared
# case-insensitively. Recomputed on EVERY sign-in, so adding an address grants admin
# at that person's next sign-in and removing one revokes it at theirs. Left empty,
# visitors can sign in but nobody can reach /admin/data, and boot logs a warning.
#
# Safety comes from three things: the ID token is rejected unless email_verified is
# true, only one Google account can hold a given address, and you chose the value
# here. This is the only path to admin — there is no password account left.
GOOGLE_ADMIN_EMAILS=

# Optional HMAC key for the signed OAuth `state`. If unset it is derived from
# GOOGLE_CLIENT_SECRET, so a third secret does not have to be provisioned. Set it
# explicitly only to rotate the state key without rotating the OAuth client.
# GOOGLE_OAUTH_STATE_SECRET=

# --- server ---------------------------------------------------------------
# PORT is assigned by the platform (Voroa sets it); 8080 is only the local
# default. Bind 0.0.0.0 regardless — a loopback-only listener is invisible to the
# platform's router.
PORT=8080
# Where the built web app lives, when it is served by this same process. When
# unset the usual local locations are tried (./public, ../web/dist). Leave it
# empty on a deployed service that serves the SPA from the same origin.
# WEB_ROOT=./public
# The platform's edge forwards the real client IP in X-Forwarded-For; without
# trusting it the app sees the proxy and per-IP rate limiting is useless. "0" is
# the only value that disables it.
TRUST_PROXY=1
# Leave empty for same-origin only, which is the correct setting when the SPA is
# served by this same process.
# CORS_ORIGINS=https://example.com

# --- schema ---------------------------------------------------------------
# Migrations run automatically on boot. Set to false to require an explicit
# `make migrate-up` instead. Worth doing on a shared or managed database if you
# would rather run migrations as a deliberate step than as part of every restart.
# MIGRATIONS_RUN=true

# --- background sync -------------------------------------------------------
# The scheduler syncs both kinds every minute and is the only thing that syncs
# data automatically. Leave it unset to keep that behaviour.
#
# Set to false on a deployment that should serve the API only -- a preview
# environment, or a second instance that must not compete for the same rows.
# Nothing syncs on a timer while this is off; syncs then happen only when
# requested from the admin panel.
#
# The exact string "false" disables it, so a typo leaves the scheduler running
# rather than silently stopping data collection.
# CRON_ENABLED=true

# --- debug ----------------------------------------------------------------
# Set to debug for verbose logging; the query/api flags are the historical
# equivalents and still work.
# LOG_LEVEL=debug
# LOG_API=1
# LOG_QUERY=1