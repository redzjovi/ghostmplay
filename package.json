{
  "name": "ghostmplay",
  "version": "0.1.0",
  "private": true,
  "description": "ghostmplay marketplace — NestJS API + SvelteKit web, deployed to DomCloud via Docker",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ghostmplay/api dev",
    "dev:api": "pnpm --filter @ghostmplay/api dev",
    "dev:web": "pnpm --filter @ghostmplay/web dev",
    "db:up": "bash scripts/dev-services.sh up",
    "db:down": "bash scripts/dev-services.sh down",
    "db:reset": "bash scripts/dev-services.sh reset",
    "db:status": "bash scripts/dev-services.sh status",
    "db:logs": "bash scripts/dev-services.sh logs",
    "build": "pnpm -r --filter @ghostmplay/shared build && pnpm --filter @ghostmplay/web build && pnpm --filter @ghostmplay/api build",
    "build:api": "pnpm --filter @ghostmplay/shared build && pnpm --filter @ghostmplay/api build",
    "start": "pnpm --filter @ghostmplay/api start:prod",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typeorm": "pnpm --filter @ghostmplay/api typeorm",
    "migration:generate": "pnpm --filter @ghostmplay/api migration:generate",
    "migration:run": "pnpm --filter @ghostmplay/api migration:run"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "3.2.4"
  }
}
