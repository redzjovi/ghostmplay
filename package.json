{
  "name": "ghostmplay",
  "version": "0.1.0",
  "description": "Windows desktop marketplace for ghostmplay — Electron + Vue 3 + NestJS + TypeORM (better-sqlite3), direct API hit",
  "private": true,
  "type": "commonjs",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "electron-rebuild -w sqlite3,better-sqlite3 -f || true",
    "rebuild": "electron-rebuild -f -w sqlite3,better-sqlite3",
    "dev": "electron-vite dev",
    "dev:debug": "cross-env LOG_API=1 LOG_QUERY=1 TYPEORM_LOGGING=true electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "preview": "electron-vite preview",
    "lint": "eslint . --ext .ts,.vue",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typeorm": "typeorm",
    "migration:generate": "typeorm migration:generate -d src/main/database/data-source.ts",
    "migration:run": "typeorm migration:run -d src/main/database/data-source.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.47.0",
    "@nestjs/axios": "^3.1.2",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/typeorm": "^10.0.2",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.13.2",
    "axios-retry": "^4.5.0",
    "better-sqlite3": "^13.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron-store": "^9.0.0",
    "lucide-vue-next": "0.511.0",
    "pinia": "^2.3.1",
    "reflect-metadata": "^0.2.2",
    "reka-ui": "2.5.0",
    "rxjs": "^7.8.2",
    "sql.js": "^1.14.2",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "typeorm": "^0.3.26",
    "vue": "^3.5.27",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.21",
    "@vitejs/plugin-vue": "^6.0.2",
    "autoprefixer": "10.4.20",
    "cross-env": "7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "3.2.4",
    "vue-tsc": "^2.2.12"
  },
  "packageManager": "pnpm@11.6.0"
}
