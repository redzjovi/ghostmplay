# A copy of the built web app placed beside the API binary, so the Go process can
# serve the SPA from one origin during development. In production this is what
# WEB_ROOT points at instead.
apps/api/public

# Go build output. The binary is not committed; the source is.
/apps/api/bin

# air's scratch directory, recreated on every `make dev`.
/apps/api/tmp

# sqlc output IS committed (db/sqlc). A deploy target needs nothing but a Go
# toolchain, so the generated code cannot depend on sqlc being installed there.
